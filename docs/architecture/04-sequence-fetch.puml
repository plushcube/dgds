@startuml
title DGDS — получение контента

actor "Пользователь (покупатель)" as user
participant "Приложение-хост" as host
participant "Фасад\n(ApiClient)" as facade
participant "Ключ устройства\n(DeviceKey)" as device
participant "Хранилище чека\n(ReceiptStore)" as receipts
participant "Транспорт\n(ApiTransport)" as transport
participant "HTTP-привязка\n(httplib, ограничитель частоты)" as http
participant "HTTPS-поверхность\n(api::Surface)" as surface
participant "Сценарии сервера" as services
participant "Ядро\n(dgds-core)" as core
participant "Адаптеры портов" as adapters
database "Реестр метаданных" as metadata
database "Хранилище контента" as blobs
database "Хранилище ключей" as keys

host -> facade: fetch_content(учётные данные, идентификатор покупки)
facade -> transport: context_identity(учётные данные, контекст)
transport -> http: HTTPS: идентичность контекста
http -> http: ограничитель частоты по адресу запроса
http -> surface: вызов операции
surface -> surface: проверка версии, разбор полей
surface -> surface: токен сессии → идентификатор пользователя
surface -> services: context_identity(пользователь, контекст)
services -> adapters: найти покупку; иначе — публикацию\nс этим идентификатором
adapters -> metadata: чтение purchases/, publications/
metadata --> adapters: PublicationRecord
note over services, adapters: Если покупки нет, идентификатор трактуется\nкак идентификатор публикации — доступ автора
services --> surface: ContentIdentity ожидаемого контента
note over services: Право на контекст проверяется здесь,\nпри выдаче пакета и при восстановлении чека;\nполя чека в решении не участвуют
surface --> http: ответ
http --> transport: HTTPS: ContentIdentity
transport --> facade: ожидаемая идентичность

facade -> device: public_key()
device --> facade: открытый ключ устройства
facade -> receipts: load(идентификатор покупки)
alt чек есть на устройстве
    receipts --> facade: непрозрачный блок
    facade -> core: decode_receipt(блок)
    core --> facade: Receipt
else чека нет — второе устройство
    receipts --> facade: receipt_not_found
    facade -> transport: restore_receipt(учётные данные,\nпокупка, открытый ключ устройства)
    transport -> http: HTTPS: восстановление чека
    http -> surface: вызов операции
    surface -> surface: проверка версии, разбор полей,\nтокен → идентификатор пользователя
    surface -> services: restore_receipt(...)
    services -> adapters: разбор контекста доступа
    services -> core: сгенерировать новый ключ покупки Kp
    core --> services: Kp (в памяти)
    services -> adapters: заново обернуть ключ файла\n(порт хранилища ключей)
    adapters -> keys: <hex идентичности>.key = E_master(Kf)
    adapters -> core: обёртка Kf ключом покупки
    core --> adapters: E_Kp(Kf)
    services -> core: обёртка E_dev(Kp): X25519 + HKDF,\nAAD: версия, идентификатор покупки, покупатель,\nдата покупки, дата выпуска
    core --> services: DeviceEnvelope
    services -> adapters: сохранить чек
    adapters -> metadata: receipts/<покупка>-<hex устройства>.receipt\n(новый ключ блоба в обёртке)
    services --> surface: Receipt (новые ключ покупки и дата выпуска,\nдата покупки и счётчик неизменны)
    surface --> http: ответ
    http --> transport: HTTPS: чек
    transport --> facade: Receipt
    facade -> receipts: save(идентификатор покупки, блок)
end

facade -> device: open_receipt_key(чек)
device --> facade: ключ покупки Kp
note over device, facade: Kp живёт только в памяти библиотеки;\nв приложение-хост он не возвращается

facade -> transport: fetch_package(учётные данные,\nпокупка, открытый ключ устройства)
transport -> http: HTTPS: запрос пакета
http -> http: ограничитель частоты по адресу запроса
http -> surface: вызов операции выдачи пакета
surface -> surface: проверка версии, разбор полей,\nтокен → идентификатор пользователя
surface -> surface: ограничитель частоты по пользователю
surface -> services: fetch_package(...)
services -> adapters: разбор контекста доступа
services -> adapters: найти чек этого устройства
adapters -> metadata: receipts/<покупка>-<hex устройства>.receipt
metadata --> adapters: ReceiptRecord (обёртка ключа блоба)
services -> adapters: прочитать хранимый блоб
adapters -> blobs: <hex идентичности>.blob
blobs --> adapters: E_Kf(контент)
services -> adapters: открыть блоб ключом файла\n(порт хранилища ключей)
adapters -> keys: <hex идентичности>.key = E_master(Kf)
adapters -> core: расшифровка
core --> adapters: контент в памяти
adapters --> services: открытый текст
services -> core: встроить метку покупки
core --> services: контент с меткой
services -> adapters: запечатать контент с меткой
adapters -> core: шифрование
core --> adapters: E_Kf(контент с меткой)
adapters --> services: E_Kf(контент с меткой)
note over services, core: Маркированный формат уникален для покупки;\nнемаркированный отдаётся как есть
services --> surface: Package { блоб, E_Kp(K_blob), идентичность,\nоткрытый ключ автора, имя автора,\nалгоритм подписи, подпись, версия }
surface --> http: ответ
http --> transport: HTTPS: пакет
transport --> facade: Package

facade -> facade: сверка идентичности пакета с ожидаемой
facade -> core: open_package(пакет, ключ покупки)
core -> core: проверить версию пакета и алгоритм подписи
core -> core: развернуть ключ блоба ключом покупки
core -> core: расшифровать в память
core -> core: сверить идентичность контента
core -> core: проверить подпись автора
core --> facade: SecureBuffer
facade --> host: расшифрованный контент
host --> user: содержимое публикации
note over host: Контент не сохраняется на диск;\nбуфер стирается при уничтожении
@enduml
