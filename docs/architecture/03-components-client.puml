@startuml
!include <C4/C4_Component>

title DGDS — компоненты клиента (C4, уровень 3)

Container_Boundary(client, "Клиентская библиотека (dgds-client)") {
  Component(facade, "Фасад и сценарии", "public client.h: регистрация, вход, каталог, публикация, покупка, список покупок, получение контента")
  Component(transport, "Транспорт", "реализация ApiTransport поверх HTTPS: закрепление ключа сервера, разбор и сборка JSON")
  Component(platform, "Платформенный адаптер", "реализация DeviceKey. Учебно: Keychain; в целевой версии — Secure Enclave")
  Component(receipts, "Хранилище чека", "реализация ReceiptStore. Учебно: файл-заглушка; в целевой версии — системное хранилище")
}

Container_Ext(host, "Приложение-хост", "C++", "Выводит полученный контент потребителю и не получает ключей")
System_Ext(devicekey, "Защищённое хранилище устройства", "Ключ устройства и чек. Учебно: Keychain; в целевой версии — Secure Enclave")
Container_Ext(server, "Серверное приложение", "C++", "HTTPS-поверхность")
Container_Ext(core, "Ядро (dgds-core)", "C++", "Канонизация, envelope, проверка подписи, расшифровка пакета, порты")

Rel(host, facade, "Запрашивает операции и получает расшифрованный контент только в память")
Rel(facade, transport, "Отправляет запросы")
Rel(facade, receipts, "Сохраняет чек как непрозрачный блок")
Rel(facade, platform, "Разворачивает ключ покупки ключом устройства")
Rel(facade, core, "Домен: канонизация, идентичность, расшифровка пакета, проверка подписи")
Rel(platform, devicekey, "Обращается к ключу устройства")
Rel(transport, server, "HTTPS и JSON")

@enduml
