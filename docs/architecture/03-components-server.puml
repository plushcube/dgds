@startuml
!include <C4/C4_Component>

title DGDS — компоненты серверного приложения (C4, уровень 3)

Container_Boundary(server, "Серверное приложение (dgds)") {
  Component(middleware, "Middleware", "авторизация, версия протокола, ограничение частоты")
  Component(controllers, "Контроллеры", "HTTP-обработчики: регистрация, вход, каталог, публикация, покупка, списки, выдача, восстановление чека")
  Component(services, "Сценарии", "публикация, покупка, выдача, восстановление чека, атрибуция утечки")
  Component(models, "Модели", "DTO запроса и ответа, ошибки, сериализация")
  Component(adapters, "Адаптеры портов", "хранилище контента, хранилище ключей, реестры, метка")
}

Container_Ext(core, "Ядро (dgds-core)", "C++", "Канонизация, идентичность, envelope, подпись, метка, порты")
ContainerDb_Ext(blobs, "Хранилище контента", "Учебно: файлы-заглушки", "Зашифрованный контент")
ContainerDb_Ext(keys, "Хранилище ключей", "Учебно: файл с мастер-ключом", "Ключи файлов")
ContainerDb_Ext(meta, "Реестр метаданных и покупок", "Учебно: файлы-заглушки", "Публикации, покупки")
ContainerDb_Ext(identities, "Реестр идентификаторов контента", "Учебно: файлы-заглушки с меткой захвата", "Захваченные идентификаторы")

Rel(controllers, middleware, "Проходит проверки до обработки")
Rel(controllers, services, "Вызывает сценарий")
Rel(controllers, models, "Формирует ответы")
Rel(services, models, "Возвращает результаты")
Rel(services, adapters, "Обращается к портам")
Rel(services, core, "Домен и криптография; вызовы портов только здесь")
Rel(adapters, blobs, "Читает и пишет")
Rel(adapters, keys, "Читает и пишет")
Rel(adapters, meta, "Читает и пишет")
Rel(adapters, identities, "Атомарно захватывает идентификатор")

@enduml
