@startuml
!include <C4/C4_Container>

title DGDS — контейнеры (C4, уровень 2)

skinparam nodesep 60
skinparam ranksep 90

Person(user, "Пользователь", "Автор или покупатель")
Container_Ext(host, "Приложение-хост", "C++, пример", "Встраивает клиентскую библиотеку и передаёт контент потребителю")

System_Boundary(dgds, "DGDS") {
  Container(client, "Клиентская библиотека", "C++, dgds-client", "Сценарии, модели, транспорт, доступ к ключу устройства")
  Container(server, "Серверное приложение", "C++, dgds", "HTTPS-поверхность, сценарии, middleware, работа с хранилищами")
  Container(core, "Ядро", "C++, библиотека dgds-core", "Домен и порты: канонизация, идентичность, envelope, подпись, метка, криптопримитивы")
}

System_Ext(devicekey, "Защищённое хранилище устройства", "Ключ устройства и чек. Учебно: Keychain; в целевой версии — Secure Enclave")
ContainerDb_Ext(blobs, "Хранилище контента", "Учебно: каталог файлов-заглушек", "Зашифрованный контент публикаций")
ContainerDb_Ext(keys, "Хранилище ключей", "Учебно: файл с мастер-ключом", "Ключи файлов, отдельно от шифротекста")
ContainerDb_Ext(meta, "Реестр метаданных и покупок", "Учебно: файлы-заглушки", "Пользователи, публикации, покупки")
ContainerDb_Ext(identities, "Реестр идентификаторов контента", "Учебно: файлы-заглушки с меткой захвата", "Захваченные идентификаторы контента")

Rel(user, host, "Работает")
Rel(host, client, "Вызывает операции публикации, покупки и получения контента")
Rel_D(client, core, "Домен и порты")
Rel_D(server, core, "Домен и порты")
Rel(client, server, "HTTPS и JSON, версия протокола в каждом запросе и ответе")
Rel(client, devicekey, "Сохраняет и разворачивает чек; ключ наружу не отдаёт")
Rel(server, blobs, "Читает и записывает шифротекст")
Rel(server, keys, "Заворачивает ключ файла на ключ покупки, не извлекая ключ")
Rel(server, meta, "Регистрирует публикации и покупки")
Rel(server, identities, "Захватывает идентификатор контента при публикации")

@enduml
